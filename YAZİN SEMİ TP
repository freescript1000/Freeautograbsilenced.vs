--//==================================================
--// FLING LOOP
--//==================================================

RunService.Heartbeat:Connect(function()

	if not antiFlingActive then
		return
	end

	if flingCooldown > os.clock() then
		return
	end

	local root = currentRootPart

	if not root or not root.Parent then

		if player.Character then
			updateRoot(player.Character)
		end

		return
	end

	local velocity = root.AssemblyLinearVelocity

	local horizontal = Vector3.new(
		velocity.X,
		0,
		velocity.Z
	)

	if horizontal.Magnitude >= FLING_THRESHOLD then

		root.AssemblyLinearVelocity = Vector3.new(
			0,
			math.clamp(velocity.Y, -50, 50),
			0
		)

		root.AssemblyAngularVelocity = Vector3.zero

		flingCooldown = os.clock() + 0.15

	end

end)

