--//==================================================
--// ANTI-FLING
--//==================================================

local antiFlingActive = false
local currentRootPart = nil
local rootConnection = nil
local flingCooldown = 0

local function disconnectRootConnection()

	if rootConnection then
		rootConnection:Disconnect()
		rootConnection = nil
	end

end

local function updateRoot(character)

	currentRootPart = nil
	disconnectRootConnection()

	local root = character:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		currentRootPart = root
		return
	end

	rootConnection = character.ChildAdded:Connect(function(child)

		if child.Name == "HumanoidRootPart"
			and child:IsA("BasePart") then

			currentRootPart = child
			disconnectRootConnection()

		end

	end)

end

local function onCharacter(character)

	flingCooldown = 0
	updateRoot(character)

end

if player.Character then
	onCharacter(player.Character)
end

player.CharacterAdded:Connect(onCharacter)

local function toggleAntiFling(enabled)

	antiFlingActive = enabled
	flingCooldown = 0

	if not enabled then
		return
	end

	if player.Character then
		updateRoot(player.Character)
	end

end

--//==================================================
--// ANTI-DIE
--//==================================================

local antiDieActive = false

local humanoidConnection = nil
local healthConnection = nil

local function cleanupAntiDie()

	if humanoidConnection then
		humanoidConnection:Disconnect()
		humanoidConnection = nil
	end

	if healthConnection then
		healthConnection:Disconnect()
		healthConnection = nil
	end

end

local function setupAntiDie(character)

	cleanupAntiDie()

	if not antiDieActive then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		humanoidConnection = character.ChildAdded:Connect(function(child)

			if child:IsA("Humanoid") then

				if humanoidConnection then
					humanoidConnection:Disconnect()
					humanoidConnection = nil
				end

				if antiDieActive then
					setupAntiDie(character)
				end

			end

		end)

		return
	end

	pcall(function()
		humanoid.BreakJointsOnDeath = false
	end)

	healthConnection = humanoid:GetPropertyChangedSignal("Health"):Connect(function()

		if not antiDieActive then
			return
		end

		if humanoid.Health <= 0 then
			pcall(function()
				humanoid.Health = humanoid.MaxHealth
			end)
		end

	end)

end

local function toggleAntiDie(enabled)

	antiDieActive = enabled

	if enabled then

		if player.Character then
			setupAntiDie(player.Character)
		end

	else

		cleanupAntiDie()

	end

end

player.CharacterAdded:Connect(function(character)

	task.defer(function()

		if antiDieActive then
			setupAntiDie(character)
		end

	end)

end)

