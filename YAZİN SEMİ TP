			knobColor = COLORS.KnobOff
			switchColor = COLORS.DarkRed
			dotColor = Color3.fromRGB(105, 18, 24)
		end

		Dot.BackgroundColor3 = dotColor

		if animated then

			local info = TweenInfo.new(
				0.16,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			)

			TweenService:Create(
				Knob,
				info,
				{
